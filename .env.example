# ── Local Development ──────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Get free Gemini API key at: https://ai.google.dev
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── Razorpay (subscription gate) ───────────────────────
# Get test keys: https://dashboard.razorpay.com/app/keys
# Test mode works without KYC — use this until you're live.
# KEY_ID is sent to the browser via the create-order response.
# KEY_SECRET MUST stay server-side (Cloudflare env). Never prefix with VITE_.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# ── Cloudflare Pages Production ────────────────────────
# Add these in Cloudflare Pages dashboard:
# Dashboard → Pages → mahabharatadecoded
#   → Settings → Environment variables → Add variable
#
# - VITE_GEMINI_API_KEY     (Production, Preview)
# - RAZORPAY_KEY_ID         (Production, Preview)
# - RAZORPAY_KEY_SECRET     (Production, Preview) — mark as "Encrypt"
# - BREVO_API_KEY           (already in use for newsletter)
# - BREVO_LIST_ID           (default "2")
